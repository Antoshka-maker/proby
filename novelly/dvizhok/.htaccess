# Адреса без .php и закрытые служебные папки
Options -Indexes
DirectoryIndex index.php
AddDefaultCharset utf-8

<IfModule mod_rewrite.c>
RewriteEngine On
# https и без www
RewriteCond %{HTTPS} off
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]
# служебные папки и файлы не отдаются
RewriteRule ^(content|data|cache|inc)(/|$) - [F,L]
RewriteRule ^(config\.php|.*\.md)$ - [F,L]
# остальное, кроме реальных файлов, обрабатывает index.php
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^ index.php [L,QSA]
</IfModule>

<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType text/css "access plus 1 year"
ExpiresByType application/javascript "access plus 1 year"
ExpiresByType font/woff2 "access plus 1 year"
ExpiresByType image/svg+xml "access plus 1 month"
</IfModule>
<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/json
</IfModule>
AddType font/woff2 .woff2
